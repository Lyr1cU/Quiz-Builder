# Local Postgres, or Neon pooler: postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quiz_builder?schema=public"
PORT=3001
# Production: your Vercel frontend URL (no trailing slash). Comma-separated if multiple.
FRONTEND_ORIGIN="http://localhost:3000"
# Random long string — required for JWT auth
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"
# Groq (Phase 4 INPUT semantic grading). Leave empty to use exact string match only.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"
AI_GRADING_ENABLED="true"
